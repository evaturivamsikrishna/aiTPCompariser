# Groq LLM judge — https://console.groq.com/keys
# Copy to .env (already gitignored) and paste your key:
GROQ_API_KEY=

# Optional: export GROQ_API_KEY in your shell instead of using .env
# Recommended judge models (Developer plan TPM):
#   llama-3.3-70b-versatile   12k TPM  — default, stronger, fewer 413s
#   openai/gpt-oss-20b         8k TPM
#   llama-3.1-8b-instant       6k TPM  — fastest, tightest cap

# Ollama is local — no key. Sidebar → Local Ollama.
# Tiny/fast:  ollama pull llama3.2:3b

# Shared dashboard login (Streamlit Cloud: App settings → Secrets).
# Leave both empty locally to skip the login gate.
DASHBOARD_EMAIL=
DASHBOARD_PASSWORD=

# Optional: persist saved comparisons on a non-deploy GitHub branch.
# GITHUB_TOKEN needs Contents read/write on the repo.
# GITHUB_REPO=owner/repo
# GITHUB_DATA_BRANCH=comparison-data
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_DATA_BRANCH=comparison-data
